wallet2 = EWallet("Алина", 1000, "сом", 1500)
wallet3 = EWallet("Нурбек", 3000, "сом", 1000)
wallet1.transfer(wallet2, 1200)
wallet2.transfer(wallet3, 500)
wallet3.transfer(wallet1, 700)
