class SecurePassword:
	def __init__(self, password):
		self.__password = ""
		self.password = password

	@property
	def password(self):
		return self.__password

	@password.setter
	def password(self, value):
		valid = True
		if len(value) < 8:
			print("Пароль должен содержать не менее 8 символов")
			valid = False
		if not any(char.isdigit() for char in value):
			print("Пароль должен содержать цифру")
			valid = False
		if not any(char.isupper() for char in value):
			print("Пароль должен содержать заглавную букву")
			valid = False
		if any(char.isspace() for char in value):
			print("Пароль не должен содержать пробелы")
			valid = False
		if valid:
			self.__password = value

	def check(self, pwd):
		return self.__password == pwd

	def strength(self):
		conditions = [
			len(self.__password) >= 8,
			any(char.isdigit() for char in self.__password),
			any(char.isupper() for char in self.__password),
			not any(char.isspace() for char in self.__password),
		]
		score = sum(conditions)
		if score <= 1:
			return "Слабый"
		if score < 4:
			return "Средний"
		return "Сильный"


passwords = ["abc", "abcdefgh", "Abcdefgh", "Abcdefg1", "Abc defg1"]
for password in passwords:
	secure_password = SecurePassword(password)
	print(password, secure_password.check(password), secure_password.strength())


class TariffPlan:
	def __init__(self, name, price, speed, minutes, sms):
		self.__name = name
		self.price = price
		self.__speed = speed
		self.__minutes = minutes
		self.__sms = sms

	@property
	def price(self):
		return self.__price

	@price.setter
	def price(self, value):
		if value <= 0:
			raise ValueError("Цена должна быть больше 0")
		self.__price = value

	@property
	def name(self):
		return self.__name

	def annual_cost(self):
		return self.__price * 12

	def discount_price(self, percent):
		return self.__price * (1 - percent / 100)

	def compare(self, other):
		return (f"{self.__name} и {other.__name}: цена {self.__price} / {other.__price}, "
				f"скорость {self.__speed} / {other.__speed} Мбит/с, "
				f"минуты {self.__minutes} / {other.__minutes}, SMS {self.__sms} / {other.__sms}")


tariffs = [
	TariffPlan("Старт", 500, 50, 300, 300),
	TariffPlan("Комфорт", 800, 100, 600, 500),
	TariffPlan("Плюс", 1200, 200, 1000, 1000),
	TariffPlan("Максимум", 1600, 300, 1500, 1500),
]
for tariff in tariffs:
	print(tariff.annual_cost(), tariff.discount_price(10))
print(tariffs[0].compare(tariffs[1]))
print("Оптимальный тариф:", min(tariffs, key=lambda tariff: tariff.price).name)


class Safe:
	def __init__(self, pin, content, master_pin):
		self.__pin = str(pin)
		self.__content = list(content)
		self.__master_pin = str(master_pin)
		self.__attempts = 0
		self.__locked = False

	def open(self, pin):
		if self.__locked:
			return "Сейф заблокирован"
		if str(pin) != self.__pin:
			self.__attempts += 1
			if self.__attempts >= 3:
				self.__locked = True
			return "Неверный PIN"
		self.__attempts = 0
		return self.__content.copy()

	def put(self, item, pin):
		if self.__locked:
			return False
		if str(pin) != self.__pin:
			self.__attempts += 1
			if self.__attempts >= 3:
				self.__locked = True
			return False
		self.__attempts = 0
		self.__content.append(item)
		return True

	def reset(self, master_pin):
		if str(master_pin) != self.__master_pin:
			return False
		self.__attempts = 0
		self.__locked = False
		return True


