class BankAccount:
	def __init__(self, owner, balance=0):
		self.__owner = owner
		self.__balance = balance
		self.__log = []

	@property
	def balance(self):
		return self.__balance

	def deposit(self, amount):
		if amount <= 0:
			return False
		self.__balance += amount
		self.__log.append(f"Пополнение: +{amount}")
		return True

	def withdraw(self, amount):
		if amount <= 0 or amount > self.__balance:
			return False
		self.__balance -= amount
		self.__log.append(f"Снятие: -{amount}")
		return True

	def get_statement(self):
		operations = "\n".join(self.__log)
		return f"Владелец: {self.__owner}\n{operations}\nБаланс: {self.__balance}"


account1 = BankAccount("Айдар", 1000)
account2 = BankAccount("Алина", 2000)
account1.deposit(500)
account1.withdraw(200)
account1.deposit(300)
account1.withdraw(100)
account1.deposit(50)
account2.withdraw(300)
account2.deposit(700)
account2.withdraw(200)
account2.deposit(100)
account2.withdraw(50)
print(account1.get_statement())
