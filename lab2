class EWallet:
	def __init__(self, owner, balance, currency, max_transfer):
		self.__owner = owner
		self.__balance = balance
		self.__currency = currency
		self.__max_transfer = max_transfer

	@property
	def balance(self):
		return self.__balance

	@property
	def can_transfer(self):
		return self.__balance > 0 and self.__max_transfer > 0

	def transfer(self, recipient, amount):
		if (not isinstance(recipient, EWallet) or recipient is self
				or not self.can_transfer or amount <= 0
				or amount > self.__max_transfer or amount > self.__balance
				or self.__currency != recipient.__currency):
			return False
		self.__balance -= amount
		recipient.__balance += amount
		return True


