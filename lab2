class MedCard:
	def __init__(self, patient, age, blood_group):
		self.__patient = patient
		self.age = age
		self.__blood_group = blood_group
		self.__diagnoses = []

	@property
	def age(self):
		return self.__age

	@age.setter
	def age(self, value):
		if not 0 <= value <= 150:
			raise ValueError("Возраст должен быть от 0 до 150")
		self.__age = value

	@property
	def is_adult(self):
		return self.__age >= 18

	def add_diagnosis(self, text):
		self.__diagnoses.append(text)

	def remove_diagnosis(self, text):
		if text in self.__diagnoses:
			self.__diagnoses.remove(text)
			return True
		return False

	def summary(self):
		return (f"Пациент: {self.__patient}\nВозраст: {self.__age}\n"
				f"Группа крови: {self.__blood_group}\nСовершеннолетний: {self.is_adult}\n"
				f"Диагнозы: {', '.join(self.__diagnoses)}")


