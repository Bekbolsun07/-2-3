class HealthMetrics:
	def __init__(self, name, height, weight, age):
		self.__name = name
		self.height = height
		self.weight = weight
		self.__age = age

	@property
	def height(self):
		return self.__height

	@height.setter
	def height(self, value):
		if not 50 <= value <= 250:
			raise ValueError("Рост должен быть от 50 до 250 см")
		self.__height = value

	@property
	def weight(self):
		return self.__weight

	@weight.setter
	def weight(self, value):
		if not 2 <= value <= 500:
			raise ValueError("Вес должен быть от 2 до 500 кг")
		self.__weight = value

	def bmi(self):
		height_m = self.__height / 100
		return self.__weight / (height_m * height_m)

	def bmi_status(self):
		bmi_value = self.bmi()
		if bmi_value < 18.5:
			return "Недовес"
		if bmi_value < 25:
			return "Норма"
		if bmi_value < 30:
			return "Избыточный вес"
		if bmi_value < 40:
			return "Ожирение"
		return "Морбидное ожирение"

	def daily_calories(self):
		return 66.5 + 13.75 * self.__weight + 5.003 * self.__height - 6.755 * self.__age


patients = [
	HealthMetrics("Айбек", 175, 70, 20),
	HealthMetrics("Алина", 165, 55, 25),
	HealthMetrics("Самат", 180, 95, 40),
	HealthMetrics("Айгуль", 160, 85, 35),
]
for patient in patients:
	print(patient.bmi(), patient.bmi_status(), patient.daily_calories())
