class StudentCard:
	def __init__(self, name, card_id, gpa):
		self.__name = name
		self.__card_id = card_id
		self.gpa = gpa

	@property
	def gpa(self):
		return self.__gpa

	@gpa.setter
	def gpa(self, value):
		if not 0.0 <= value <= 4.0:
			raise ValueError("GPA должен быть от 0.0 до 4.0")
		self.__gpa = value

	@property
	def status(self):
		if self.__gpa >= 3.5:
			return "Отличник"
		if self.__gpa >= 2.5:
			return "Хорошист"
		if self.__gpa >= 1.0:
			return "Удовлетворительно"
		return "Отчислен"


