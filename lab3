# 6. Продукты питания
class Food:
	def __init__(self, name, calories, proteins, fats, carbohydrates, price_kg):
		self.name = name
		self.calories = calories
		self.proteins = proteins
		self.fats = fats
		self.carbohydrates = carbohydrates
		self.price_kg = price_kg

	def label(self):
		return (f"{self.name}: {self.calories} ккал, Б {self.proteins} г, "
				f"Ж {self.fats} г, У {self.carbohydrates} г на 100 г; "
				f"{self.price_kg} сом/кг")

	def calories_per_serving(self, serving_g):
		return self.calories * serving_g / 100


class Dairy(Food):
	def __init__(self, name, calories, proteins, fats, carbohydrates, price_kg,
				 fat_percent, shelf_life, dairy_type):
		super().__init__(name, calories, proteins, fats, carbohydrates, price_kg)
		self.fat_percent = fat_percent
		self.shelf_life = shelf_life
		self.dairy_type = dairy_type

	def is_fresh(self, days):
		return days <= self.shelf_life

	def label(self):
		return (f"{super().label()} | {self.dairy_type}, "
				f"жирность {self.fat_percent}% | срок хранения {self.shelf_life} дней")


class Bakery(Food):
	def __init__(self, name, calories, proteins, fats, carbohydrates, price_kg,
				 ingredients, weight, bakery_type):
		super().__init__(name, calories, proteins, fats, carbohydrates, price_kg)
		self.ingredients = ingredients
		self.weight = weight
		self.bakery_type = bakery_type

	def label(self):
		return (f"{super().label()} | {self.bakery_type}, {self.weight} г | "
				f"состав: {', '.join(self.ingredients)}")


foods = [
	Dairy("Молоко", 60, 3, 3.2, 4.7, 90, 3.2, 7, "молоко"),
	Dairy("Кефир", 53, 3, 2.5, 4, 85, 2.5, 5, "кефир"),
	Dairy("Йогурт", 75, 4, 3, 8, 140, 3, 10, "йогурт"),
	Bakery("Хлеб", 250, 8, 3, 48, 70, ["мука", "вода", "соль"], 500, "хлеб"),
	Bakery("Булочка", 310, 7, 9, 50, 180, ["мука", "молоко", "сахар"], 100, "булочка"),
	Bakery("Торт", 380, 5, 20, 45, 600, ["мука", "яйца", "крем"], 1000, "торт"),
]
for food in foods:
	print(food.label())
	print(f"Калорийность порции 150 г: {food.calories_per_serving(150):.1f} ккал")
	if isinstance(food, Dairy):
		print(f"Свежий через 4 дня: {food.is_fresh(4)}")
print()


# 7. Музыкальные инструменты
class Instrument:
	def __init__(self, name, country, year, instrument_type):
		self.name = name
		self.country = country
		self.year = year
		self.instrument_type = instrument_type

	def play(self):
		return f"{self.name} играет"

	def tune(self):
		return f"{self.name} настроен"

	def describe(self):
		return (f"{self.name}: {self.instrument_type}, {self.country}, "
				f"создан в {self.year} г.")


class StringInstrument(Instrument):
	def __init__(self, name, country, year, instrument_type, strings, material,
				 playing_type):
		super().__init__(name, country, year, instrument_type)
		self.strings = strings
		self.material = material
		self.playing_type = playing_type

	def describe(self):
		return (f"{super().describe()} | струн: {self.strings} | "
				f"дека: {self.material} | {self.playing_type}")


class WindInstrument(Instrument):
	def __init__(self, name, country, year, instrument_type, note_range,
				 material, wind_type):
		super().__init__(name, country, year, instrument_type)
		self.note_range = note_range
		self.material = material
		self.wind_type = wind_type

	def describe(self):
		return (f"{super().describe()} | диапазон: {self.note_range} | "
				f"материал: {self.material} | {self.wind_type}")


