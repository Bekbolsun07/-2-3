# 1. Сотрудники компании
class Employee:
	def __init__(self, name, position, base_salary, years):
		self.name = name
		self.position = position
		self.base_salary = base_salary
		self.years = years

	def salary(self):
		return self.base_salary

	def introduce(self):
		return f"{self.name} — {self.position}, стаж {self.years} лет"


class Manager(Employee):
	def __init__(self, name, department, subordinates, bonus_percent,
				 base_salary, years):
		super().__init__(name, "Менеджер", base_salary, years)
		self.department = department
		self.subordinates = subordinates
		self.bonus_percent = bonus_percent

	def salary(self):
		return self.base_salary * (1 + self.bonus_percent / 100)

	def introduce(self):
		return (f"{super().introduce()}, отдел: {self.department}, "
				f"подчинённых: {self.subordinates}")


class Developer(Employee):
	LEVEL_BONUS = {"junior": 0, "middle": 30, "senior": 60}

	def __init__(self, name, language, level, base_salary, years):
		super().__init__(name, "Разработчик", base_salary, years)
		self.language = language
		self.level = level

	def salary(self):
		return self.base_salary * (1 + self.LEVEL_BONUS[self.level] / 100)

	def introduce(self):
		return (f"{super().introduce()}, язык: {self.language}, "
				f"уровень: {self.level}")


team = [
	Manager("Айбек", "Продажи", 5, 20, 80000, 8),
	Manager("Алина", "Разработка", 4, 15, 90000, 6),
	Developer("Нурбек", "Python", "senior", 100000, 7),
	Developer("Айжан", "Java", "middle", 80000, 4),
	Developer("Тимур", "C++", "junior", 60000, 1),
	Employee("Самат", "Бухгалтер", 70000, 5),
]
for employee in team:
	print(employee.introduce())
	print(f"Зарплата: {employee.salary():.0f} сом")
print(f"Зарплатный фонд: {sum(employee.salary() for employee in team):.0f} сом")
print()


# 2. Туристическое агентство
class TourPackage:
	def __init__(self, name, country, days, base_price):
		self.name = name
		self.country = country
		self.days = days
		self.base_price = base_price

	def season_discount(self, month):
		return 0

	def total_price(self, persons, month):
		return self.base_price * persons * (1 - self.season_discount(month) / 100)

	def describe(self):
		return f"{self.name}, {self.country}, {self.days} дней"


class BeachTour(TourPackage):
	def __init__(self, name, country, days, base_price, resort, hotel,
				 flight, food):
		super().__init__(name, country, days, base_price)
		self.resort = resort
		self.hotel = hotel
		self.flight = flight
		self.food = food

	def season_discount(self, month):
		if month in (11, 12, 1, 2, 3):
			return 20
		if month in (4, 5, 9, 10):
			return 10
		return 0

	def describe(self):
		flight = "перелёт включён" if self.flight else "без перелёта"
		return (f"[Пляжный тур] {super().describe()} | курорт: {self.resort} | "
				f"отель: {self.hotel}* | {flight} | питание: {self.food}")


class AdventureTour(TourPackage):
	def __init__(self, name, country, days, base_price, route, fitness,
				 equipment, guide):
		super().__init__(name, country, days, base_price)
		self.route = route
		self.fitness = fitness
		self.equipment = equipment
		self.guide = guide

	def season_discount(self, month):
		if month in (12, 1, 2):
			return 15
		if month in (3, 4, 9, 10, 11):
			return 10
		return 0

	def describe(self):
		guide = "гид включён" if self.guide else "без гида"
		return (f"[Приключенческий тур] {super().describe()} | маршрут: {self.route} | "
				f"подготовка: {self.fitness} | снаряжение: "
				f"{', '.join(self.equipment)} | {guide}")


