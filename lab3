# 5. Недвижимость
class Property:
	def __init__(self, address, area, price, year_built):
		self.address = address
		self.area = area
		self.price = price
		self.year_built = year_built

	def price_per_sqm(self):
		return self.price / self.area

	def is_affordable(self, budget):
		return self.price <= budget

	def age(self):
		return date.today().year - self.year_built

	def describe(self):
		return (f"{self.address}: {self.area} м², {self.price} сом, "
				f"построен в {self.year_built} г.")


class Apartment(Property):
	def __init__(self, address, area, price, year_built, floor, rooms,
				 balcony, apartment_type):
		super().__init__(address, area, price, year_built)
		self.floor = floor
		self.rooms = rooms
		self.balcony = balcony
		self.apartment_type = apartment_type

	def describe(self):
		balcony = "есть балкон" if self.balcony else "без балкона"
		return (f"[Квартира] {super().describe()} | этаж: {self.floor} | "
				f"комнат: {self.rooms} | {balcony} | {self.apartment_type}")


class House(Property):
	def __init__(self, address, area, price, year_built, floors, land_area,
				 material, garage):
		super().__init__(address, area, price, year_built)
		self.floors = floors
		self.land_area = land_area
		self.material = material
		self.garage = garage

	def describe(self):
		garage = "есть гараж" if self.garage else "без гаража"
		return (f"[Дом] {super().describe()} | этажей: {self.floors} | "
				f"участок: {self.land_area} соток | {self.material} | {garage}")


properties = [
