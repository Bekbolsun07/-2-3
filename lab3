# 3. Бытовая техника
class Appliance:
	def __init__(self, brand, power, price, energy_class):
		self.brand = brand
		self.power = power
		self.price = price
		self.energy_class = energy_class

	def spec(self):
		return (f"{self.brand}: {self.power} Вт, {self.price} сом, "
				f"класс {self.energy_class}")

	def energy_cost(self, hours, rate):
		return self.power / 1000 * hours * rate

	def compare(self, other):
		if self.price < other.price:
			return f"{self.brand} дешевле, чем {other.brand}"
		if self.price > other.price:
			return f"{self.brand} дороже, чем {other.brand}"
		return "Цена одинаковая"


class WashingMachine(Appliance):
	def __init__(self, brand, power, price, energy_class, drum_kg, modes,
				 temperature):
		super().__init__(brand, power, price, energy_class)
		self.drum_kg = drum_kg
		self.modes = modes
		self.temperature = temperature

	def spec(self):
		return (f"[Стиральная машина] {super().spec()} | барабан: {self.drum_kg} кг | "
				f"режимы: {', '.join(self.modes)} | температура: {self.temperature}°C")


class Refrigerator(Appliance):
	def __init__(self, brand, power, price, energy_class, volume, chambers,
				 freezer_temperature):
		super().__init__(brand, power, price, energy_class)
		self.volume = volume
		self.chambers = chambers
		self.freezer_temperature = freezer_temperature

	def spec(self):
		return (f"[Холодильник] {super().spec()} | объём: {self.volume} л | "
				f"камер: {self.chambers} | морозилка: {self.freezer_temperature}°C")


appliances = [
	WashingMachine("Samsung", 2000, 45000, "A++", 8, ["хлопок", "быстрая"], 60),
	WashingMachine("LG", 1800, 40000, "A+", 7, ["хлопок", "деликатная"], 40),
	WashingMachine("Bosch", 2100, 52000, "A++", 9, ["эко", "быстрая"], 90),
	Refrigerator("Beko", 300, 35000, "A+", 300, 2, -18),
	Refrigerator("LG", 250, 50000, "A++", 400, 2, -20),
