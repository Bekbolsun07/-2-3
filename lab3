print(appliances[0].compare(appliances[1]))
print()


# 4. Спортсмены
class Athlete:
	def __init__(self, name, age, country, awards):
		self.name = name
		self.age = age
		self.country = country
		self.awards = awards

	def achievement(self):
		return f"{self.name}: наград — {self.medals_count()}"

	def add_medal(self, medal, year):
		self.awards.append((medal, year))

	def medals_count(self):
		return len(self.awards)

	def avg_speed(self):
		return 0


class Swimmer(Athlete):
	def __init__(self, name, age, country, awards, specialization, record_100m,
				 style):
		super().__init__(name, age, country, awards)
		self.specialization = specialization
		self.record_100m = record_100m
		self.style = style

	def avg_speed(self):
		return 100 / self.record_100m


class Sprinter(Athlete):
	def __init__(self, name, age, country, awards, distance, record, starts):
		super().__init__(name, age, country, awards)
		self.distance = distance
		self.record = record
		self.starts = starts

	def avg_speed(self):
		return self.distance / self.record


