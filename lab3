# 8. Горные вершины
class Mountain:
	def __init__(self, name, height, country, first_ascent):
		self.name = name
		self.height = height
		self.country = country
		self.first_ascent = first_ascent

	def describe(self):
		return (f"{self.name}: {self.height} м, {self.country}, "
				f"первое восхождение — {self.first_ascent} г.")

	def is_highaltitude(self):
		return self.height > 5000

	def climbing_difficulty(self):
		return "не указана"


class Peak(Mountain):
	DIFFICULTIES = {
		1: "очень лёгкая", 2: "лёгкая", 3: "средняя",
		4: "сложная", 5: "очень сложная",
	}

	def __init__(self, name, height, country, first_ascent, difficulty,
				 route_type, route_length):
		super().__init__(name, height, country, first_ascent)
		self.difficulty = difficulty
		self.route_type = route_type
		self.route_length = route_length

	def describe(self):
		return (f"[Вершина] {super().describe()} | сложность: {self.difficulty}/5 | "
				f"маршрут: {self.route_type}, {self.route_length} км")

	def climbing_difficulty(self):
		return self.DIFFICULTIES[self.difficulty]


class Volcano(Mountain):
	def __init__(self, name, height, country, first_ascent, status,
				 last_eruption, crater_diameter):
		super().__init__(name, height, country, first_ascent)
		self.status = status
		self.last_eruption = last_eruption
		self.crater_diameter = crater_diameter

	def describe(self):
		return (f"[Вулкан] {super().describe()} | статус: {self.status} | "
				f"последнее извержение: {self.last_eruption} г. | "
				f"диаметр кратера: {self.crater_diameter} м")


